/** the hdf object module */
module org.hdfgroup.object
{
    requires static java.compiler;

    exports hdf.object;
    exports hdf.object.fits;
    exports hdf.object.h4;
    exports hdf.object.h5;
    exports hdf.object.nc2;

    requires netcdf;
    requires fits;
    requires jarhdf;
    // HDF5 Java FFM (org.hdfgroup:hdf5-java-ffm) — non-modular build; add explicit `requires` when module-info is re-enabled
    requires org.slf4j;
}
